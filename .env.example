DATABASE_URL=
USDINR_RATE=87
DELTA_REST_URL=https://api.india.delta.exchange
BINANCE_REST_URL=https://fapi.binance.com
KUCOIN_REST_URL=https://api-futures.kucoin.com
ASTER_REST_URL=https://fapi.asterdex.com
BYBIT_REST_URL=https://api.bybit.com
COINBASE_REST_URL=https://api.coinbase.com
COINBASE_INTX_URL=https://api.international.coinbase.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINDCX_REST_URL=https://api.coindcx.com
COINDCX_API_KEY=
COINDCX_API_SECRET=
COINDCX_FUTURES_MARGIN_CCY=INR
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Login cookie days (iPhone Safari). Default 30. HTTP Basic no longer prompts the phone.
# DASHBOARD_COOKIE_DAYS=30
# Folder that contains stack.py. Default is the sibling ../OPA6. Ignored on Railway.
# OPA6_ROOT=
#
# Railway: New contract creates a sibling OPA6 *service* (not a local process).
# Add a project token from https://railway.com/account/tokens
# RAILWAY_TOKEN=
# Existing OPA6 bot in this project (repo + DATABASE_URL are copied from it):
# OPA6_RAILWAY_SERVICE=OPA6
# Fallback if no template service: GitHub repo Railway already deploys for OPA6
# OPA6_GITHUB_REPO=your-user/OPA6
REPORT_INTERVAL_SECONDS=300
DELTA_API_KEY=
DELTA_API_SECRET=

# Live Balances page — one block per subaccount (repeat BAL_2_*, BAL_3_*, …).
# Same `id` on Delta + CoinDCX lands on one row. Values convert to INR (USDINR_RATE).
# BAL_1_EXCHANGE=delta
# BAL_1_ID=22354431
# BAL_1_NAME=ARBUSD
# BAL_1_KEY=
# BAL_1_SECRET=
# BAL_2_EXCHANGE=coindcx
# BAL_2_ID=22354431
# BAL_2_NAME=ARBUSD hedge
# BAL_2_KEY=
# BAL_2_SECRET=
# Coinbase CDP key (portal.cdp.coinbase.com → API keys). No passphrase.
# Key name looks like organizations/.../apiKeys/... and the secret is the private key.
# BAL_3_EXCHANGE=coinbase
# BAL_3_ID=cb-perp
# BAL_3_NAME=Perp
# BAL_3_KEY=
# BAL_3_SECRET=
# Or a JSON file (copy config/accounts.example.json → config/accounts.json):
# BALANCE_ACCOUNTS_FILE=

# Delta parent/main API key — required to transfer USD between subaccounts from Balances.
# Subaccount trading keys (DELTA_API_KEY / BAL_* subs) cannot transfer.
# PROFIT_SWEEP_API_KEY=
# PROFIT_SWEEP_API_SECRET=
# Or mark the parent row in accounts.json with "parent": true, or:
# BAL_1_PARENT=true
